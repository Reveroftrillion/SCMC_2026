Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 160
      Alpha: 0.5
      Line Style:
        Line Width: 0.03
        Value: Lines
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: VLP16 Points
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /velodyne_points
      Selectable: true
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Color Transformer: Intensity
      Use Rainbow: true
      Autocompute Intensity Bounds: true
  Enabled: true
  Global Options:
    Fixed Frame: velodyne
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
    - Class: rviz/PublishPoint
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0
      Target Frame: velodyne
      Value: Orbit (rviz)