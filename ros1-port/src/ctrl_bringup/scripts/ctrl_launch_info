#!/usr/bin/env python3
"""Launch-time metadata; no ROS initialization and no simulator connection."""
from datetime import datetime
from pathlib import Path
import subprocess
import sys


def code_version():
    source = Path(__file__).resolve().parent
    try:
        def git(*arguments):
            return subprocess.run(['git', '-C', str(source)] + list(arguments),
                                  capture_output=True, text=True, timeout=2).stdout.strip()
        branch, commit = git('rev-parse', '--abbrev-ref', 'HEAD'), git('rev-parse', '--short', 'HEAD')
        return '{}@{}{}'.format(branch, commit, '+dirty' if git('status', '--porcelain', '--untracked-files=no') else '') if commit else ''
    except (OSError, subprocess.SubprocessError):
        return ''


def main():
    command = sys.argv[1]
    if command == 'bag-name':
        result = 'run_' + datetime.now().strftime('%Y%m%d_%H%M%S')
    elif command == 'detections-log':
        logs = Path.home() / 'foscar_logs' / 'yolo'
        logs.mkdir(parents=True, exist_ok=True)
        result = str(logs / (datetime.now().strftime('%Y%m%d_%H%M%S') + '_cam7.jsonl'))
    elif command == 'prepare-run-dir':
        folder = Path(sys.argv[2]).expanduser().resolve()
        folder.mkdir(parents=True, exist_ok=True)
        result = str(folder)
    elif command == 'code-version':
        result = code_version()
    else:
        raise ValueError('unknown launch metadata command: ' + command)
    # roslaunch command parameters retain stdout verbatim, including newlines.
    print(result, end='')


if __name__ == '__main__':
    main()
