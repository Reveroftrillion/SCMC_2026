Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 600
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
      Color: 100; 100; 100
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic: /sensors/lidar/points
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
    - Class: rviz/MarkerArray
      Name: Obstacles
      Enabled: true
      Namespaces: {}
      Topic: /perception/obstacle_markers
      Queue Size: 5
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 45
      Focal Point:
        X: 15
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.14
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
