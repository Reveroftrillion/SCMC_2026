<launch>
    <node pkg="perception" type="anom_depth_ros.py" name="anom_depth_ros" output="screen">
        <param name="ckpt" type="str" value="model.onnx" />
        <param name="right_topic" type="str" value="/image_jpeg/compressed" />
        <param name="left_topic" type="str" value="/image_jpeg2/compressed" />
        <param name="show_vis" type="bool" value="true" />
        <param name="use_sgbm" type="bool" value="true" />
        <param name="num_disp" type="int" value="128" />
        <param name="block" type="int" value="5" />
        <param name="fx_px" type="double" value="320.0" />
        <param name="baseline_m" type="double" value="0.20" />
        <param name="depth_scale" type="double" value="1.0" />
        <param name="thres_method" type="str" value="percentile" />
        <param name="thres" type="double" value="98.8" />
        <param name="score_thres" type="double" value="0.42" />
        <param name="box_score_method" type="str" value="p95" />
        <param name="box_score_thres" type="double" value="0.65" />
        <param name="min_area" type="int" value="1800" />
        <param name="disp_min" type="double" value="0.3" />
        <param name="disp_max" type="double" value="256" />
        <param name="depth_debug" type="bool" value="true" />
        <param name="fast_mode" type="bool" value="true" />
        

        <param name="bbox_center_x_min" type="int" value="30" />
        <param name="bbox_center_x_max" type="int" value="460" />
        <param name="bbox_center_y_min" type="int" value="140" />
        <param name="bbox_center_y_max" type="int" value="620" />

    </node>
</launch>